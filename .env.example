# ---- Database ----
POSTGRES_DB=kazirobot
POSTGRES_USER=kazirobot
POSTGRES_PASSWORD=change-me-strong-db-password
DATABASE_URL=postgresql+psycopg://kazirobot:change-me-strong-db-password@db:5432/kazirobot

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0

# ---- Security ----
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-64-hex-chars
ACCESS_TOKEN_MINUTES=480
# Comma separated origins allowed to call the API (your dashboard domain)
CORS_ORIGINS=http://localhost
# First admin, created automatically on first start if no users exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# ---- WordPress (kept server-side only, never sent to the browser) ----
WP_URL=https://your-wordpress-site.com
WP_USERNAME=your-wp-username
# WordPress -> Users -> Profile -> Application Passwords
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ---- Misc ----
HTTP_PORT=80
USER_AGENT=KaziRobot/1.0 (+https://your-domain.com/bot)
